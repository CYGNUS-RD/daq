
COMMENT "Data Taking"

ODBSET "/Equipment/HV/Variables/ChState[0]", "1"

#WAIT seconds, 3

ODBSET "/Configurations/Exposure", "0.3"
ODBSET "/Configurations/FreeRunning", "1"
ODBSET "/Configurations/Pedestal", "0"
ODBSET "/Logger/Write data", "1"

WAIT seconds, 3

##################################

#### FIELD 300
SCRIPT "python3 ./ArduinoServerManager/rpcClient_setField_MANGOlino.py -f 0.3 -gem 400 400 400"
WAIT seconds, 15

ODBSET "/Equipment/HV/Variables/Demand[6]", "300" 
WAIT seconds, 60

LOOP 4
    SCRIPT "python3 ./ArduinoServerManager/rpcClient_GetInfoMANGOlino.py -m 1"
    WAIT seconds, 20
    RUNDESCRIPTION "INAF - ED - 60/40 - 1Atm - Sr source"
    TRANSITION START
    WAIT events, 250
    TRANSITION STOP
ENDLOOP

