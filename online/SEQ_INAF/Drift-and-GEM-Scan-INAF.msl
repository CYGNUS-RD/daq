COMMENT "INAF - Drift and GEM scan - 0.6/0.8/1.0 kV/cm - 390/400/410/420/430 - Fe/Cd/Sr"

ODBSET "/Equipment/HV/Variables/ChState[0]", "1"

ODBSET "/Configurations/Exposure", "0.3"
ODBSET "/Configurations/FreeRunning", "0"
ODBSET "/Configurations/Pedestal", "0"
ODBSET "/Logger/Write data", "1"

############################################################

WAIT seconds, 3

#############  Voltage 390 - Field 0.6 kV/cm   #############

ODBSET "/Equipment/HV/Variables/Demand[0]", "0"
ODBSET "/Equipment/HV/Variables/Demand[1]", "390"
ODBSET "/Equipment/HV/Variables/Demand[2]", "2.5"
ODBSET "/Equipment/HV/Variables/Demand[3]", "390"
ODBSET "/Equipment/HV/Variables/Demand[4]", "2.5"
ODBSET "/Equipment/HV/Variables/Demand[5]", "390"
ODBSET "/Equipment/HV/Variables/Demand[6]", "0.6"

SCRIPT "python3 ./ArduinoServerManager/rpcClient_setField_MANGOlino.py -f 0.6 -gem 390 390 390"


WAIT seconds, 15

LOOP 3
    SCRIPT "python3 ./ArduinoServerManager/rpcClient_GetInfoMANGOlino.py -m 1"
    WAIT seconds, 5
    RUNDESCRIPTION "INAF - ED - 60/40 - 1Atm - Calib - Fe/Cd/Sr"
    TRANSITION START
    WAIT events, 250
    TRANSITION STOP
ENDLOOP

