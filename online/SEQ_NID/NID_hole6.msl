COMMENT "Data Taking - NID 650mbar He/CF4 60/40/1.6"

GOTO 11

######################################################### POS 64.5  ###################################################################################################################################################
ODBSET "/Configurations/StepperMotor/SelectedPosition", "6"
ODBSET "/Configurations/StepperMotor/buttonPressed", "y"
WAIT ODBvalue, "/Configurations/SourceState/source_position", ==, "6"

######################## DATA PREPARATION ########################
ODBSET "/Equipment/HV/Variables/ChState[0]", "1"
ODBSET "/Configurations/Exposure", "0.3"
ODBSET "/Configurations/FreeRunning", "0"
ODBSET "/Configurations/Pedestal", "0"
ODBSET "/Configurations/pmt_acquisition", "1"
ODBSET "/Logger/Write data", "1"

ODBSET "/Equipment/HV/Variables/Demand[0]", "0.0"
ODBSET "/Equipment/HV/Variables/Demand[1]", "540"
ODBSET "/Equipment/HV/Variables/Demand[2]", "2.5"
ODBSET "/Equipment/HV/Variables/Demand[3]", "530"
ODBSET "/Equipment/HV/Variables/Demand[4]", "2.5"
ODBSET "/Equipment/HV/Variables/Demand[5]", "520"

######################## CYCLE ON FIELDS ########################

##### POS 0 - HOLE 6 - FIELD 0.6 #####
SCRIPT "python3 /home/cygno01/daq/online/ArduinoServerManager/rpcClient_setField_KEG.py -f 0.6 -gem 540 530 520"
ODBSET "/Equipment/HV/Variables/Demand[6]", "0.6" 
WAIT seconds, 15

LOOP 4
    WAIT seconds, 20
    RUNDESCRIPTION "NID - 60/40/1.6 - 650mbar - HOLE 6"
    TRANSITION START
    WAIT events, 250
    TRANSITION STOP
ENDLOOP

