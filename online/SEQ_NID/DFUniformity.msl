COMMENT "Data Taking - ED 650mbar He/CF4 60/40 - FUSION"

######################## DATA PREPARATION ########################
ODBSET "/Equipment/HV/Variables/ChState[0]", "1"
ODBSET "/Configurations/Exposure", "0.3"
ODBSET "/Configurations/FreeRunning", "1"
ODBSET "/Configurations/Pedestal", "0"
ODBSET "/Configurations/pmt_acquisition", "0"
ODBSET "/Logger/Write data", "1"

ODBSET "/Equipment/HV/Variables/Demand[0]", "0.0"
ODBSET "/Equipment/HV/Variables/Demand[1]", "400"
ODBSET "/Equipment/HV/Variables/Demand[2]", "2.5"
ODBSET "/Equipment/HV/Variables/Demand[3]", "400"
ODBSET "/Equipment/HV/Variables/Demand[4]", "2.5"
ODBSET "/Equipment/HV/Variables/Demand[5]", "400"
ODBSET "/Equipment/HV/Variables/Demand[6]", "0.3" 
SCRIPT "python3 ./ArduinoServerManager/rpcClient_setField_KEG.py -f 0.3 -gem 400 400 400"
WAIT seconds, 20

LOOP 30
    RUNDESCRIPTION "ED - 60/40 - Cosmics - FUSION - DF uniformity"

    TRANSITION START
    WAIT events, 400
    TRANSITION STOP
ENDLOOP

