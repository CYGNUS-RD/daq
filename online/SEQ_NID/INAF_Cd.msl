COMMENT "Data Taking - ED 1000mbar Ar/CF4 60/40 - QUEST - EHD"

######################## DATA PREPARATION ########################
ODBSET "/Equipment/HV/Variables/ChState[0]", "1"
ODBSET "/Configurations/Exposure", "0.01"
ODBSET "/Configurations/FreeRunning", "1"
ODBSET "/Configurations/Pedestal", "0"
ODBSET "/Configurations/pmt_acquisition", "0"
ODBSET "/Logger/Write data", "1"

ODBSET "/Equipment/HV/Variables/Demand[0]", "0.0"
ODBSET "/Equipment/HV/Variables/Demand[1]", "440"
ODBSET "/Equipment/HV/Variables/Demand[2]", "2.5"
ODBSET "/Equipment/HV/Variables/Demand[3]", "440"
ODBSET "/Equipment/HV/Variables/Demand[4]", "2.5"
ODBSET "/Equipment/HV/Variables/Demand[5]", "440"
ODBSET "/Equipment/HV/Variables/Demand[6]", "1.0" 

LOOP 20
    RUNDESCRIPTION "INAF - Cd109 - Ar/CF4 60/40 - QUEST - EHD - 300 ccm"
    TRANSITION START
    WAIT events, 400
    TRANSITION STOP
    #WAIT seconds, 1200
ENDLOOP
