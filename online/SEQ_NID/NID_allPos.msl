COMMENT "Data Taking - NID 650mbar He/CF4 60/40/1.6"

#GOTO 12

######################################################### POS 0 ###################################################################################################################################################
ODBSET "/Configurations/StepperMotor/SelectedPosition", "12"
#ODBSET "/Configurations/StepperMotor/buttonPressed", "y"
WAIT ODBvalue, "/Configurations/SourceState/source_position", ==, "12"


######################## DATA PREPARATION ########################
ODBSET "/Equipment/HV/Variables/ChState[0]", "1"
ODBSET "/Configurations/Exposure", "0.3"
ODBSET "/Configurations/FreeRunning", "1"
ODBSET "/Configurations/Pedestal", "0"
ODBSET "/Configurations/pmt_acquisition", "0"
ODBSET "/Logger/Write data", "1"

ODBSET "/Equipment/HV/Variables/Demand[0]", "0.0"
ODBSET "/Equipment/HV/Variables/Demand[1]", "525"
ODBSET "/Equipment/HV/Variables/Demand[2]", "2.5"
ODBSET "/Equipment/HV/Variables/Demand[3]", "525"
ODBSET "/Equipment/HV/Variables/Demand[4]", "2.5"
ODBSET "/Equipment/HV/Variables/Demand[5]", "525"

######################## CYCLE ON FIELDS ########################

##### POS 0 - HOLE 12 - FIELD 0.3 #####
SCRIPT "python3 /home/cygno01/daq/online/ArduinoServerManager/rpcClient_setField_KEG.py -f 0.3 -gem 525 525 525"
ODBSET "/Equipment/HV/Variables/Demand[6]", "0.3" 
WAIT seconds, 15

LOOP 10
    WAIT seconds, 20
    RUNDESCRIPTION "NID - 60/40/1.6 - 650mbar - HOLE 12"
    TRANSITION START
    WAIT events, 500
    TRANSITION STOP
ENDLOOP


