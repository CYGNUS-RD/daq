######################################################### POS 107.5  ###################################################################################################################################################
#SCRIPT "python3 ./ArduinoServerManager/rpcClient_setSourceMIDAS.py -p 107.5"
#WAIT ODBvalue, "/Equipment/MANGOSensors/Settings/SerialBusy", ==, "n"
#WAIT seconds, 10
#WAIT ODBvalue, "/Equipment/MANGOSensors/Settings/SerialBusy", ==, "n"

######################## DATA PREPARATION ########################
ODBSET "/Equipment/HV/Variables/ChState[0]", "1"
ODBSET "/Configurations/Exposure", "0.2"
ODBSET "/Configurations/FreeRunning", "0"
ODBSET "/Configurations/Pedestal", "0"
ODBSET "/Configurations/pmt_acquisition", "1"
ODBSET "/Logger/Write data", "1"

ODBSET "/Equipment/HV/Variables/Demand[0]", "0.0"
ODBSET "/Equipment/HV/Variables/Demand[1]", "310"
ODBSET "/Equipment/HV/Variables/Demand[2]", "2.5"
ODBSET "/Equipment/HV/Variables/Demand[3]", "310"
ODBSET "/Equipment/HV/Variables/Demand[4]", "2.5"
ODBSET "/Equipment/HV/Variables/Demand[5]", "310"

######################## CYCLE ON FIELDS ########################

##### POS 0 - HOLE 2 - FIELD 0.3 #####
SCRIPT "python3 ./ArduinoServerManager/rpcClient_setField_KEG.py -f 0.3 -gem 310 310 310"
ODBSET "/Equipment/HV/Variables/Demand[6]", "0.3" 
WAIT seconds, 15

LOOP 4
    WAIT seconds, 20
    RUNDESCRIPTION "ED - 60/40 - 650mbar - HOLE 2"
    TRANSITION START
    WAIT events, 250
    TRANSITION STOP
ENDLOOP


