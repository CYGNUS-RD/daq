COMMENT "Data Taking - ED 900mbar He/CF4 60/40 - FUSION - Schenider"

######################## DATA PREPARATION ########################
ODBSET "/Equipment/HV/Variables/ChState[0]", "1"
ODBSET "/Configurations/Exposure", "0.2"
ODBSET "/Configurations/FreeRunning", "0"
ODBSET "/Configurations/Pedestal", "0"
ODBSET "/Configurations/pmt_acquisition", "1"
ODBSET "/Logger/Write data", "1"

ODBSET "/Equipment/HV/Variables/Demand[0]", "0.0"
ODBSET "/Equipment/HV/Variables/Demand[1]", "310"
ODBSET "/Equipment/HV/Variables/Demand[2]", "2.5"
ODBSET "/Equipment/HV/Variables/Demand[3]", "310"
ODBSET "/Equipment/HV/Variables/Demand[4]", "2.5"
ODBSET "/Equipment/HV/Variables/Demand[5]", "310"


######################################################### POS 0  ###################################################################################################################################################
SCRIPT "python3 ./ArduinoServerManager/rpcClient_setSourceMIDAS.py -p 0"
WAIT ODBvalue, "/Equipment/MANGOSensors/Settings/SerialBusy", ==, "n"
WAIT seconds, 30
WAIT ODBvalue, "/Equipment/MANGOSensors/Settings/SerialBusy", ==, "n"
WAIT seconds, 7

##### HOLE 12 - FIELD 0.5 #####
SCRIPT "python3 ./ArduinoServerManager/rpcClient_setField_KEG.py -f 0.5 -gem 310 310 310"
ODBSET "/Equipment/HV/Variables/Demand[6]", "0.5" 
WAIT seconds, 15

LOOP 4
    WAIT seconds, 20
    RUNDESCRIPTION "ED - 60/40 - 900mbar - HOLE 12"
    TRANSITION START
    WAIT events, 250
    TRANSITION STOP
ENDLOOP

##### HOLE 12 - FIELD 0.6 #####
SCRIPT "python3 ./ArduinoServerManager/rpcClient_setField_KEG.py -f 0.6 -gem 310 310 310"
ODBSET "/Equipment/HV/Variables/Demand[6]", "0.6" 
WAIT seconds, 15

LOOP 4
    WAIT seconds, 20
    RUNDESCRIPTION "ED - 60/40 - 900mbar - HOLE 12"
    TRANSITION START
    WAIT events, 250
    TRANSITION STOP
ENDLOOP

