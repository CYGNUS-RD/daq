COMMENT "FUSION - ED - He/CF4 60/40 650mbar - 241Am"

######################## DATA ########################
ODBSET "/Equipment/HV/Variables/ChState[0]", "1"
ODBSET "/Configurations/Exposure", "0.5"
ODBSET "/Configurations/FreeRunning", "0"
ODBSET "/Configurations/Pedestal", "0"
ODBSET "/Logger/Write data", "1"

ODBSET "/Equipment/HV/Variables/Demand[0]", "0.0"
ODBSET "/Equipment/HV/Variables/Demand[1]", "300"
ODBSET "/Equipment/HV/Variables/Demand[2]", "2.5"
ODBSET "/Equipment/HV/Variables/Demand[3]", "300"
ODBSET "/Equipment/HV/Variables/Demand[4]", "2.5"
ODBSET "/Equipment/HV/Variables/Demand[5]", "300"
ODBSET "/Equipment/HV/Variables/Demand[6]", "1.0"
SCRIPT "python3 ./ArduinoServerManager/rpcClient_setField_KEG.py -f 0.6 -gem 300 300 300"

WAIT seconds, 30

LOOP 30
    #WAIT seconds, 900
    SCRIPT "python3 ./ArduinoServerManager/rpcClient_GetInfo.py -m 1"
    WAIT seconds, 5
    RUNDESCRIPTION "FUSION - ED - He/CF4 60/40 650mbar - 241Am"
    TRANSITION START
    WAIT events, 250
    TRANSITION STOP
ENDLOOP

############################################################

