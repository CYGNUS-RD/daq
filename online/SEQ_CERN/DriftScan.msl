COMMENT "QUEST- He/CF4-HFO 60/40/5 CERN - Fe55"


######################## DATA ########################
ODBSET "/Equipment/HV/Variables/ChState[0]", "1"
ODBSET "/Configurations/Exposure", "0.2"
ODBSET "/Configurations/FreeRunning", "0"
ODBSET "/Configurations/Pedestal", "0"
ODBSET "/Logger/Write data", "1"

ODBSET "/Equipment/HV/Variables/Demand[0]", "0.0"
ODBSET "/Equipment/HV/Variables/Demand[1]", "480"
ODBSET "/Equipment/HV/Variables/Demand[2]", "2.5"
ODBSET "/Equipment/HV/Variables/Demand[3]", "480"
ODBSET "/Equipment/HV/Variables/Demand[4]", "2.5"
ODBSET "/Equipment/HV/Variables/Demand[5]", "480"
ODBSET "/Equipment/HV/Variables/Demand[6]", "0.5"
SCRIPT "python3 ./ArduinoServerManager/rpcClient_setField_MANGOLINO.py -f 0.5 -gem 480 480 480 -o 0"

WAIT seconds, 5

LOOP 1
  WAIT seconds, 10
  RUNDESCRIPTION "QUEST - He/CF4-HFO 60/40/5 - Fe55 - GEM 480 - CERN"
  TRANSITION START
  WAIT events, 500
  TRANSITION STOP
ENDLOOP
############################################################

