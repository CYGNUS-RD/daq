COMMENT "QUEST- Charge calibration - CERN"


######################## DATA ########################
ODBSET "/Equipment/HV/Variables/ChState[0]", "0"
ODBSET "/Configurations/Exposure", "0.2"
ODBSET "/Configurations/FreeRunning", "0"
ODBSET "/Configurations/Pedestal", "0"
ODBSET "/Logger/Write data", "0"

ODBSET "/Equipment/HV/Variables/Demand[0]", "0"
ODBSET "/Equipment/HV/Variables/Demand[1]", "0"
ODBSET "/Equipment/HV/Variables/Demand[2]", "0"
ODBSET "/Equipment/HV/Variables/Demand[3]", "0"
ODBSET "/Equipment/HV/Variables/Demand[4]", "0"
ODBSET "/Equipment/HV/Variables/Demand[5]", "0"
ODBSET "/Equipment/HV/Variables/Demand[6]", "0"

WAIT seconds, 10

WAIT seconds, 5
RUNDESCRIPTION "QUEST - Charge calibration - 2.50E-14 CERN"
TRANSITION START
WAIT events, 100
TRANSITION STOP

